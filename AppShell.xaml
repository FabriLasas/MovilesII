<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ExploradorPersonajes.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vistas="clr-namespace:ExploradorPersonajes.Vistas"
    Title="Explorador de Personajes">

    <!--  Página raíz. Las páginas secundarias se registran como rutas en el code-behind.  -->
    <ShellContent
        Title="Personajes"
        ContentTemplate="{DataTemplate vistas:PersonajesPage}"
        Route="personajes" />

</Shell>
