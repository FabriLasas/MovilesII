<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true"></application>

	<!-- Red: consumo de la API y detección de conexión. -->
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />

	<!-- Respuesta táctil al marcar favoritos y al guardar un avistamiento. -->
	<uses-permission android:name="android.permission.VIBRATE" />

	<!-- Avistamientos: foto con la cámara (permiso en tiempo de ejecución). -->
	<uses-permission android:name="android.permission.CAMERA" />

	<!-- Lectura de fotos en versiones viejas de Android. Desde Android 13 (API 33)
	     el selector de fotos del sistema no necesita ningún permiso. -->
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

	<!-- Ubicación del avistamiento, solo mientras la app está en uso
	     (permiso en tiempo de ejecución). Nunca en segundo plano. -->
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

	<!-- required="false": la app se puede instalar en dispositivos sin cámara
	     o sin GPS; esas funciones se desactivan en lugar de impedir la
	     instalación desde la tienda. -->
	<uses-feature android:name="android.hardware.camera" android:required="false" />
	<uses-feature android:name="android.hardware.location.gps" android:required="false" />

	<!-- Desde Android 11 hay que declarar qué otras apps se van a abrir:
	     sin esto, la app de cámara no aparece y la captura falla. -->
	<queries>
		<intent>
			<action android:name="android.media.action.IMAGE_CAPTURE" />
		</intent>
	</queries>
</manifest>
