<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ExploradorPersonajes.Vistas.DetallePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:comp="clr-namespace:ExploradorPersonajes.Comportamientos"
    xmlns:vm="clr-namespace:ExploradorPersonajes.ViewModels"
    x:DataType="vm:DetalleViewModel"
    Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Image
                Aspect="AspectFill"
                HeightRequest="220"
                Source="{Binding Personaje.ImagenUrl}"
                WidthRequest="220">
                <Image.Clip>
                    <RoundRectangleGeometry CornerRadius="16" Rect="0,0,220,220" />
                </Image.Clip>
                <Image.Behaviors>
                    <comp:AparicionGradualBehavior />
                </Image.Behaviors>
            </Image>

            <Label
                FontAttributes="Bold"
                FontSize="26"
                HorizontalTextAlignment="Center"
                Text="{Binding Personaje.Nombre}" />

            <!--  La acción cambia de texto según el estado. El pulso y la
                  vibración confirman el toque.  -->
            <Button
                Command="{Binding AlternarFavoritoCommand}"
                HorizontalOptions="Center"
                Text="{Binding TextoBotonFavorito}">
                <Button.Behaviors>
                    <comp:PulsoAlTocarBehavior />
                </Button.Behaviors>
            </Button>

            <!--  Ficha de propiedades: la consigna pide al menos dos; se muestran cinco  -->
            <Border
                Padding="16"
                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1">
                <Border.Behaviors>
                    <comp:AparicionGradualBehavior />
                </Border.Behaviors>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">

                    <Label Grid.Row="0" Grid.Column="0" FontAttributes="Bold" Text="Estado" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Personaje.EstadoTraducido}" TextColor="{Binding Personaje.ColorEstado}" />

                    <Label Grid.Row="1" Grid.Column="0" FontAttributes="Bold" Text="Especie" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Personaje.Especie}" />

                    <Label Grid.Row="2" Grid.Column="0" FontAttributes="Bold" Text="Género" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Personaje.Genero}" />

                    <Label Grid.Row="3" Grid.Column="0" FontAttributes="Bold" Text="Origen" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Personaje.Origen.Nombre}" />

                    <Label Grid.Row="4" Grid.Column="0" FontAttributes="Bold" Text="Ubicación" />
                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding Personaje.UbicacionActual.Nombre}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
