<?xml version="1.0" encoding="UTF-8" ?>
<!--  Plantillas compartidas entre la lista de personajes y la pestaña de
      favoritos. Definirlas una sola vez garantiza que ambas pantallas se vean
      iguales y que un cambio de diseño se haga en un único lugar.  -->
<ResourceDictionary
    x:Class="ExploradorPersonajes.Vistas.Plantillas.PlantillasPersonaje"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:comp="clr-namespace:ExploradorPersonajes.Comportamientos"
    xmlns:vm="clr-namespace:ExploradorPersonajes.ViewModels">

    <!--  Tarjeta de un personaje. Todos los comandos pertenecen al ViewModel
          del ítem, así que no hace falta buscar el ViewModel de la página.  -->
    <DataTemplate x:Key="TarjetaPersonaje" x:DataType="vm:PersonajeItemViewModel">

        <!--  Deslizar la tarjeta hacia la derecha la marca o desmarca como
              favorita, como alternativa táctil a tocar la estrella.  -->
        <SwipeView Margin="0,0,0,10">
            <SwipeView.LeftItems>
                <SwipeItems Mode="Execute">
                    <SwipeItem
                        BackgroundColor="#F1C40F"
                        Command="{Binding AlternarFavoritoCommand}"
                        Text="{Binding TextoAccionFavorito}" />
                </SwipeItems>
            </SwipeView.LeftItems>

            <!--  Fondo opaco: sin él, la acción de deslizar se vería a través
                  de la tarjeta.  -->
            <Border
                Padding="10"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#262626}"
                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1">
                <Border.Behaviors>
                    <comp:AparicionGradualBehavior />
                </Border.Behaviors>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">

                    <!--  Zona que abre el detalle. La estrella queda fuera de
                          ella a propósito: así tocar la estrella nunca navega.  -->
                    <Grid Grid.Column="0" ColumnDefinitions="64,*" ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VerDetalleCommand}" />
                        </Grid.GestureRecognizers>

                        <Image
                            Grid.Column="0"
                            Aspect="AspectFill"
                            HeightRequest="64"
                            Source="{Binding ImagenUrl}"
                            WidthRequest="64">
                            <Image.Clip>
                                <RoundRectangleGeometry CornerRadius="8" Rect="0,0,64,64" />
                            </Image.Clip>
                        </Image>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="2"
                            VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="{Binding Nombre}" />
                            <Label
                                FontSize="13"
                                Text="{Binding Subtitulo}"
                                TextColor="{Binding ColorEstado}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button
                        Grid.Column="1"
                        Padding="0"
                        BackgroundColor="Transparent"
                        Command="{Binding AlternarFavoritoCommand}"
                        FontSize="26"
                        HeightRequest="48"
                        SemanticProperties.Description="Marcar o desmarcar como favorito"
                        Text="{Binding IconoFavorito}"
                        TextColor="#F1C40F"
                        VerticalOptions="Center"
                        WidthRequest="48">
                        <Button.Behaviors>
                            <comp:PulsoAlTocarBehavior />
                        </Button.Behaviors>
                    </Button>
                </Grid>
            </Border>
        </SwipeView>
    </DataTemplate>

    <!--  Franja que avisa que se están mostrando datos guardados.  -->
    <Style x:Key="EstiloAvisoCache" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#FFF4D6" />
        <Setter Property="Stroke" Value="#F0C36D" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
</ResourceDictionary>
