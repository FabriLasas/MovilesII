<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ExploradorPersonajes.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vistas="clr-namespace:ExploradorPersonajes.Vistas"
    Title="Explorador de Personajes">

    <!--  Navegación por pestañas: cada sección principal es una pestaña
          hermana, y el detalle se apila encima de cualquiera de ellas. En
          Android se muestran abajo; en Windows, arriba.  -->
    <TabBar>
        <Tab Title="Personajes" Icon="tab_personajes.png">
            <ShellContent ContentTemplate="{DataTemplate vistas:PersonajesPage}" Route="personajes" />
        </Tab>
        <Tab Title="Favoritos" Icon="tab_favoritos.png">
            <ShellContent ContentTemplate="{DataTemplate vistas:FavoritosPage}" Route="favoritos" />
        </Tab>
    </TabBar>

</Shell>
