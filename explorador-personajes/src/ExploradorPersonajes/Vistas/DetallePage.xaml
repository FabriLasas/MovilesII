<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ExploradorPersonajes.Vistas.DetallePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:comp="clr-namespace:ExploradorPersonajes.Comportamientos"
    xmlns:vm="clr-namespace:ExploradorPersonajes.ViewModels;assembly=ExploradorPersonajes.Core"
    x:DataType="vm:DetalleViewModel"
    Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Image
                Aspect="AspectFill"
                HeightRequest="220"
                Source="{Binding Personaje.ImagenUrl}"
                WidthRequest="220">
                <Image.Clip>
                    <RoundRectangleGeometry CornerRadius="16" Rect="0,0,220,220" />
                </Image.Clip>
                <Image.Behaviors>
                    <comp:AparicionGradualBehavior />
                </Image.Behaviors>
            </Image>

            <Label
                FontAttributes="Bold"
                FontSize="26"
                HorizontalTextAlignment="Center"
                Text="{Binding Personaje.Nombre}" />

            <!--  La acción cambia de texto según el estado. El pulso y la
                  vibración confirman el toque.  -->
            <Button
                Command="{Binding AlternarFavoritoCommand}"
                HorizontalOptions="Center"
                Text="{Binding TextoBotonFavorito}">
                <Button.Behaviors>
                    <comp:PulsoAlTocarBehavior />
                </Button.Behaviors>
            </Button>

            <!--  Ficha de propiedades: la consigna pide al menos dos; se muestran cinco  -->
            <Border
                Padding="16"
                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1">
                <Border.Behaviors>
                    <comp:AparicionGradualBehavior />
                </Border.Behaviors>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">

                    <Label Grid.Row="0" Grid.Column="0" FontAttributes="Bold" Text="Estado" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Personaje.EstadoTraducido}" TextColor="{Binding Personaje.ColorEstado}" />

                    <Label Grid.Row="1" Grid.Column="0" FontAttributes="Bold" Text="Especie" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Personaje.Especie}" />

                    <Label Grid.Row="2" Grid.Column="0" FontAttributes="Bold" Text="Género" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Personaje.Genero}" />

                    <Label Grid.Row="3" Grid.Column="0" FontAttributes="Bold" Text="Origen" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Personaje.Origen.Nombre}" />

                    <Label Grid.Row="4" Grid.Column="0" FontAttributes="Bold" Text="Ubicación" />
                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding Personaje.UbicacionActual.Nombre}" />
                </Grid>
            </Border>

            <!--  Avistamientos: fotos que el usuario registró de este personaje  -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label FontAttributes="Bold" FontSize="18" Text="Avistamientos" />
                    <Label FontSize="13" Text="{Binding ResumenAvistamientos}" TextColor="#7F8C8D" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    Command="{Binding NuevoAvistamientoCommand}"
                    Text="📷  Nuevo"
                    VerticalOptions="Center" />
            </Grid>

            <!--  BindableLayout y no CollectionView: la lista va dentro del
                  ScrollView de la página y son pocos elementos.  -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Avistamientos}" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:AvistamientoItemViewModel">
                        <Border
                            Padding="10"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Border.Behaviors>
                                <comp:AparicionGradualBehavior />
                            </Border.Behaviors>
                            <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="12">
                                <Image
                                    Aspect="AspectFill"
                                    HeightRequest="72"
                                    Source="{Binding RutaFoto}"
                                    WidthRequest="72">
                                    <Image.Clip>
                                        <RoundRectangleGeometry CornerRadius="8" Rect="0,0,72,72" />
                                    </Image.Clip>
                                </Image>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label LineBreakMode="WordWrap" Text="{Binding Nota}" />
                                    <Label FontSize="12" Text="{Binding TextoFecha}" TextColor="#7F8C8D" />
                                    <Label FontSize="12" Text="{Binding TextoUbicacion}" TextColor="#7F8C8D" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="2"
                                    Padding="10,0"
                                    BackgroundColor="Transparent"
                                    Command="{Binding EliminarCommand}"
                                    SemanticProperties.Description="Eliminar avistamiento"
                                    Text="🗑"
                                    TextColor="#C0392B"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
