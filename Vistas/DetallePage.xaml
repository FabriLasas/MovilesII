<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ExploradorPersonajes.Vistas.DetallePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:modelos="clr-namespace:ExploradorPersonajes.Modelos"
    xmlns:vm="clr-namespace:ExploradorPersonajes.ViewModels"
    x:DataType="vm:DetalleViewModel"
    Title="{Binding Titulo}">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            BindingContext="{Binding Personaje}"
            Spacing="16"
            x:DataType="modelos:Personaje">

            <Image
                Aspect="AspectFill"
                HeightRequest="220"
                Source="{Binding ImagenUrl}"
                WidthRequest="220">
                <Image.Clip>
                    <RoundRectangleGeometry CornerRadius="16" Rect="0,0,220,220" />
                </Image.Clip>
            </Image>

            <Label
                FontAttributes="Bold"
                FontSize="26"
                HorizontalTextAlignment="Center"
                Text="{Binding Nombre}" />

            <!--  Ficha de propiedades: la consigna pide al menos dos; se muestran cinco  -->
            <Border
                Padding="16"
                Stroke="#E0E0E0"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">

                    <Label Grid.Row="0" Grid.Column="0" FontAttributes="Bold" Text="Estado" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding EstadoTraducido}" TextColor="{Binding ColorEstado}" />

                    <Label Grid.Row="1" Grid.Column="0" FontAttributes="Bold" Text="Especie" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Especie}" />

                    <Label Grid.Row="2" Grid.Column="0" FontAttributes="Bold" Text="Género" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Genero}" />

                    <Label Grid.Row="3" Grid.Column="0" FontAttributes="Bold" Text="Origen" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Origen.Nombre}" />

                    <Label Grid.Row="4" Grid.Column="0" FontAttributes="Bold" Text="Ubicación" />
                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding UbicacionActual.Nombre}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
