<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AgendaContactosMaui.Vistas.ContactoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AgendaContactosMaui.ViewModels"
    Title="{Binding Titulo}"
    x:DataType="vm:ContactoViewModel">

    <ContentPage.Resources>
        <Style x:Key="Etiqueta" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="6">

            <!--  El Id sólo existe para contactos ya guardados  -->
            <Label IsVisible="{Binding EsExistente}" Style="{StaticResource Etiqueta}" Text="Id" />
            <Label
                Margin="0,0,0,10"
                FontSize="16"
                IsVisible="{Binding EsExistente}"
                Text="{Binding Id}" />

            <Label Style="{StaticResource Etiqueta}" Text="Nombre" />
            <Entry
                IsReadOnly="{Binding EsExistente}"
                MaxLength="{Binding MaxNombre}"
                Placeholder="Nombre y apellido"
                Text="{Binding Nombre}" />
            <Grid Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                <Label
                    FontSize="12"
                    IsVisible="{Binding EsExistente}"
                    Text="El nombre no se puede modificar."
                    TextColor="{StaticResource Gray500}" />
                <Label Grid.Column="1" FontSize="12" TextColor="{StaticResource Gray500}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Nombre.Length}" />
                            <Span Text="/" />
                            <Span Text="{Binding MaxNombre}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>

            <Label Style="{StaticResource Etiqueta}" Text="Teléfono" />
            <Entry
                Margin="0,0,0,10"
                Keyboard="Telephone"
                Placeholder="11-1234-5678"
                Text="{Binding Telefono}" />

            <Label Style="{StaticResource Etiqueta}" Text="Email" />
            <Entry
                Margin="0,0,0,10"
                Keyboard="Email"
                Placeholder="nombre@mail.com"
                Text="{Binding Email}" />

            <Label
                x:Name="EtiquetaError"
                FontAttributes="Bold"
                IsVisible="{Binding HayError}"
                PropertyChanged="EtiquetaError_PropertyChanged"
                Text="{Binding MensajeError}"
                TextColor="#C0392B" />

            <Button
                Margin="0,12,0,0"
                Command="{Binding GuardarCommand}"
                Text="Guardar" />

            <!--  Extra: eliminar el contacto por su Id  -->
            <Button
                BackgroundColor="Transparent"
                BorderColor="#C0392B"
                BorderWidth="1"
                Command="{Binding EliminarCommand}"
                IsVisible="{Binding EsExistente}"
                Text="Eliminar contacto"
                TextColor="#C0392B" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
